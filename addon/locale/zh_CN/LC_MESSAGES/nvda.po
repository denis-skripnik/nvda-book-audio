msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_CN\n"

msgid "&Голос:"
msgstr "语音(&V)："

msgid "&Добавить файлы…"
msgstr "添加文件(&A)…"

msgid "&Закрыть"
msgstr "关闭(&C)"

msgid "&Запуск"
msgstr "开始(&S)"

msgid "&Остановить"
msgstr "停止(&P)"

msgid "&Удалить выбранный"
msgstr "移除所选(&R)"

msgid "Book Audio — текст в MP3"
msgstr "Book Audio — 文本转 MP3"

msgid "Book Audio — текст в MP3…"
msgstr "Book Audio — 文本转 MP3…"

msgid "FB2 в архиве слишком большой: допустимо не более 128 МиБ."
msgstr "压缩包中的 FB2 文件过大：最大允许 128 MiB。"

msgid "PDF защищён паролем. Сначала снимите защиту документа."
msgstr "PDF 受密码保护。请先移除文档保护。"

msgid "{name}: часть {index} из {chapters}. {title}"
msgstr "{name}：第 {index} 部分，共 {chapters} 部分。{title}"

msgid "Авто"
msgstr "自动"

msgid "Авто (структура FB2 / нумерованные TXT/PDF)"
msgstr "自动（FB2 结构 / 编号 TXT/PDF）"

msgid ""
"Авто: структура книги / доступные закладки, затем Глава/Часть/Chapter/Part + "
"номер."
msgstr ""
"自动：书籍结构 / 可用书签，然后是 Глава/Часть/Chapter/Part + "
"编号。"

msgid "Аннотация"
msgstr "内容简介"

msgid "Архив FB2.ZIP должен содержать ровно один файл FB2."
msgstr "FB2.ZIP 压缩包必须只包含一个 FB2 文件。"

msgid "Архив FB2.ZIP зашифрован. Сначала снимите защиту архива."
msgstr "FB2.ZIP 压缩包已加密。请先移除压缩包保护。"

msgid "Архив FB2.ZIP повреждён: неверный размер файла FB2."
msgstr "FB2.ZIP 压缩包已损坏：FB2 文件大小不正确。"

msgid "Архив FB2.ZIP содержит небезопасное имя файла."
msgstr "FB2.ZIP 压缩包包含不安全的文件名。"

msgid "Битрейт MP3 должен быть целым числом: 64, 96, 128, 160 или 192 кбит/с."
msgstr "MP3 比特率必须是整数：64、96、128、160 或 192 kbps。"

msgid "Битрейт MP3, к&бит/с:"
msgstr "MP3 比特率（kbps）(&B)："

msgid ""
"В PDF нет доступного текста. Выполните распознавание текста (OCR) и "
"повторите попытку."
msgstr ""
"PDF 中没有可用文本。请先执行光学字符识别（OCR）"
"后再试。"

msgid "В пакете отсутствует среда синтеза Python."
msgstr "软件包中缺少 Python 合成运行环境。"

msgid "В файле «{name}» нет текста для озвучивания."
msgstr "文件“{name}”中没有可供朗读的文本。"

msgid "Выберите голос."
msgstr "请选择语音。"

msgid "Выберите существующую папку для сохранения."
msgstr "请选择一个已存在的输出文件夹。"

msgid "Выберите существующую папку сохранения."
msgstr "请选择一个已存在的输出文件夹。"

msgid "Выберите файлы и папку."
msgstr "请选择文件和输出文件夹。"

msgid "Выбранный драйвер не поддерживает дополнительные паузы."
msgstr "所选驱动不支持额外停顿。"

msgid "Выбрать &папку…"
msgstr "选择文件夹(&F)…"

msgid "Выполнено в текущем файле"
msgstr "当前文件进度"

msgid "Выходной файл уже существует: {destination}"
msgstr "输出文件已存在：{destination}"

msgid "Г&ромкость, от 0 до 100:"
msgstr "音量（0 到 100）(&L)："

msgid "Глава"
msgstr "章"

msgid "Голоса загружены. Выберите файлы, папку и нажмите «Запуск»."
msgstr "语音已加载。请选择文件和文件夹，然后按“开始”。"

msgid "Готово. Создано MP3: {count}. Папка: {folder}"
msgstr "完成。已创建 MP3：{count} 个。文件夹：{folder}"

msgid "Громкость должна быть целым числом от 0 до 100."
msgstr "音量必须是 0 到 100 之间的整数。"

msgid "Громкость, от 0 до 100:"
msgstr "音量（0 到 100）："

msgid "Для проверки голоса установите громкость выше 0."
msgstr "请将音量调至 0 以上以验证语音。"

msgid "Добавить текстовые файлы"
msgstr "添加文本文档"

msgid "Добавьте хотя бы один файл."
msgstr "请至少添加一个文件。"

msgid "Документ слишком большой: допустимо не более 128 МиБ."
msgstr "文档过大：最大允许 128 MiB。"

msgid "Дополнительная пауза в конце пр&едложения, мс:"
msgstr "句末额外停顿（毫秒）(&E)："

msgid "Дополнительная пауза после зап&ятой, мс:"
msgstr "逗号后额外停顿（毫秒）(&M)："

msgid "Доступные драйверы синтеза не найдены."
msgstr "未找到可用的语音合成驱动。"

msgid "Драйвер &синтезатора:"
msgstr "语音合成驱动(&D)："

msgid "Драйвер изменил формат звука внутри главы. Выберите другой голос."
msgstr ""
"驱动在章节内更改了音频格式。请选择其他语音。"

msgid "Драйвер не передал PCM-аудио. Выберите другой синтезатор."
msgstr "驱动未提供 PCM 音频。请选择其他语音合成器。"

msgid ""
"Драйвер не передал PCM-аудио. Запись этого синтезатора не поддерживается."
msgstr ""
"驱动未提供 PCM 音频。不支持录制此语音合成器。"

msgid "Драйвер не сообщает о завершении речи и не поддерживается."
msgstr "驱动不报告朗读完成状态，暂不支持。"

msgid "Драйвер передал неполный аудиокадр."
msgstr "驱动提供了不完整的音频帧。"

msgid "Загрузка голосов выбранного синтезатора…"
msgstr "正在加载所选语音合成器的语音…"

msgid "Запись не проверена для выбранного драйвера, голоса и скорости."
msgstr "尚未验证所选驱动、语音和语速的录制效果。"

msgid ""
"Запись не проверена для выбранного драйвера, голоса, скорости и громкости."
msgstr ""
"尚未验证所选驱动、语音、语速和音量的录制效果。"

msgid "Запись проверена для выбранного драйвера, голоса и скорости."
msgstr "已验证所选驱动、语音和语速的录制效果。"

msgid "Запись проверена для выбранного драйвера, голоса, скорости и громкости."
msgstr "已验证所选驱动、语音、语速和音量的录制效果。"

msgid "Книга"
msgstr "书籍"

msgid ""
"Книги FB2, FB2.ZIP, TXT, PDF (*.fb2;*.fb2.zip;*.txt;*.pdf)|"
"*.fb2;*.fb2.zip;*.txt;*.pdf"
msgstr ""
"书籍 FB2、FB2.ZIP、TXT、PDF (*.fb2;*.fb2.zip;*.txt;*.pdf)|"
"*.fb2;*.fb2.zip;*.txt;*.pdf"

msgid "Куда сохранять аудиокниги?"
msgstr "有声书保存到哪里？"

msgid "Начинается создание аудиокниг…"
msgstr "正在开始转换有声书…"

msgid "Не найдена установленная NVDA: library.zip отсутствует."
msgstr "未找到已安装的 NVDA：缺少 library.zip。"

msgid "Не удалось определить кодировку TXT. Сохраните файл в UTF-8 или UTF-16."
msgstr ""
"无法确定 TXT 编码。请将文件保存为 UTF-8 或 UTF-16。"

msgid "Не удалось подобрать свободное имя папки."
msgstr "无法找到可用的文件夹名称。"

msgid "Не удалось прочитать FB2: повреждённый или небезопасный XML."
msgstr "无法读取 FB2：XML 已损坏或不安全。"

msgid "Не удалось прочитать PDF: файл повреждён или не поддерживается."
msgstr "无法读取 PDF：文件已损坏或不受支持。"

msgid ""
"Не удалось прочитать архив FB2.ZIP: архив повреждён или не поддерживается."
msgstr "无法读取 FB2.ZIP：压缩包已损坏或不受支持。"

msgid "Не удалось прочитать файл. Проверьте путь и права доступа."
msgstr "无法读取文件。请检查路径和访问权限。"

msgid "Не удалось создать MP3 при проверке записи."
msgstr "录制测试时无法创建 MP3。"

msgid "Неизвестное действие."
msgstr "未知操作。"

msgid "Неизвестный режим разбиения книги."
msgstr "未知的书籍拆分模式。"

msgid "Неподдерживаемый формат. Выберите файл FB2, FB2.ZIP, TXT или PDF."
msgstr "不支持的格式。请选择 FB2、FB2.ZIP、TXT 或 PDF 文件。"

msgid "Один файл на книгу"
msgstr "每本书一个文件"

msgid "Озвучивать аннотацию FB2, если она есть"
msgstr "如有 FB2 内容简介则一并朗读"

msgid "Остановка и закрытие…"
msgstr "正在停止并关闭…"

msgid "Остановка процесса синтеза…"
msgstr "正在停止合成…"

msgid "Остановлено. Уже сохранённые MP3 оставлены в выбранной папке."
msgstr "已停止。已生成的 MP3 文件保留在所选文件夹中。"

msgid "Открыть окно Book Audio"
msgstr "打开 Book Audio 窗口"

msgid "Ошибка загрузки голосов: "
msgstr "无法加载语音："

msgid "Ошибка проверки записи: "
msgstr "录制验证失败："

msgid "Ошибка синтеза."
msgstr "合成错误。"

msgid "Папка сохранения:"
msgstr "输出文件夹："

msgid "Параметр озвучивания аннотации должен быть логическим значением."
msgstr "内容简介朗读选项必须为布尔值。"

msgid "Пауза должна быть целым числом от 0 до 2000 мс."
msgstr "停顿时长必须是 0 到 2000 毫秒之间的整数。"

msgid "По структуре книги"
msgstr "按书籍结构"

msgid "По фразе в начале строки (старый режим)"
msgstr "按行首短语（旧版模式）"

msgid "Поддерживается только моно или стерео."
msgstr "仅支持单声道或立体声。"

msgid "Предисловие"
msgstr "前言"

msgid "Проверить запись"
msgstr "验证录制"

msgid "Проверка записи голоса."
msgstr "语音录制测试。"

msgid "Проверка записи остановлена. Запись не проверена."
msgstr "录制验证已停止。尚未验证录制效果。"

msgid "Проверка записи:"
msgstr "录制验证："

msgid "Проверка записи…"
msgstr "正在检查录制…"

msgid "Процесс не вернул список голосов."
msgstr "工作进程未返回语音列表。"

msgid "Процесс проверки не подтвердил запись выбранного голоса."
msgstr ""
"验证进程未确认所选语音的录制。"

msgid "Процесс синтеза завершился с кодом {code}. {diagnostics}"
msgstr "合成进程已退出，退出代码为 {code}。{diagnostics}"

msgid "Процесс синтеза не отвечает более 4 минут."
msgstr "合成进程已超过 4 分钟未响应。"

msgid "Разбиение на части:"
msgstr "拆分为多部分："

msgid "С&корость NVDA, от 0 до 100:"
msgstr "NVDA 语速（0 到 100）(&T)："

msgid "Синтезатор выдал не 16-битный PCM; этот формат пока не поддерживается."
msgstr ""
"合成器未输出 16 位 PCM；暂不支持此格式。"

msgid "Синтезатор не завершил фрагмент за 3 минуты."
msgstr "合成器未在 3 分钟内完成该片段。"

msgid "Синтезатор не завершил фрагмент за отведённое время."
msgstr "合成器未在规定时间内完成该片段。"

msgid "Синтезатор передал только тишину. Выберите другой голос."
msgstr "合成器仅输出了静音。请选择其他语音。"

msgid "Состояние:"
msgstr "状态："

msgid "У этого драйвера нет доступных голосов."
msgstr "此驱动没有可用语音。"

msgid "Файлы в порядке обработки:"
msgstr "按处理顺序排列的文件："

msgid "Фраза начала заголовка (Авто: TXT/PDF; старый режим):"
msgstr "标题前缀（自动：TXT/PDF；旧版模式）："

msgid "Фраза разделения в начале строки (пусто — весь файл):"
msgstr "行首分隔短语（留空表示整个文件）："

msgid "Чтение файла {file_index} из {files}: {name}"
msgstr "正在读取第 {file_index} 个文件，共 {files} 个：{name}"

msgid ""
"Эта сборка рассчитана на NVDA с Python 3.13 x64 (проверены NVDA 2026.2 и "
"2026.3). Нужна подходящая сборка дополнения."
msgstr ""
"此构建版本需要搭载 Python 3.13 x64 的 NVDA（已测试 NVDA 2026.2 和 "
"2026.3）。请使用匹配的插件构建版本。"
